MYSQL_ROOT_PASSWORD=root
CIGC_JWT_KEY=change-me-jwt-key
CIGC_ADMIN_USERNAME=admin
CIGC_ADMIN_PASSWORD=admin123
CIGC_GENESIS_ADDRESS=0x8Bd86ad98D9fA366E52CFB5c08a3e33f5f412Fb1
CIGC_HTTP_ADDR=0.0.0.0:8000
CIGC_DATABASE_DSN=root:root@tcp(mysql:3306)/cigc?charset=utf8mb4&parseTime=True&loc=Asia%2FShanghai&time_zone=%27%2B08%3A00%27
CIGC_ALLOW_FORCE_SETTLE=true
CIGC_SETTLE_CRON=0 0 * * *
CIGC_SETTLE_TIMEZONE=Asia/Shanghai
CIGC_BSC_RPC=https://bsc-dataseed.binance.org/
CIGC_USDT_ADDRESS=0x55d398326f99059fF775485246999027B3197955
CIGC_DEPOSIT_CONFIRMATIONS=12
# 空则不定时扫链，只靠管理 POST /deposit_scan。yaml 已带 7 个收款地址。
# CIGC_DEPOSIT_CRON=*/1 * * * *
# CIGC_RECEIVE_ADDRESS=
# CIGC_RECEIVE_ADDRESSES=[{"address":"0xdf4cbc6c9c4f084b6e75177852c6a29f206b8fe1","percent":"89"}]
# 打款默认关。开启时必须同时设上限、热钱包、RPC、USDT 合约。
CIGC_PAYOUT_ENABLED=false
# CIGC_PAYOUT_CRON=*/5 * * * *
# CIGC_PAYOUT_MAX_USDT=1000
# CIGC_HOT_WALLET_KEY=
